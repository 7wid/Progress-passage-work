[Unit]
Description=Tech Request GHCR pull CD (dry-run by default)
Wants=network-online.target
After=network-online.target docker.service
OnFailure=tech-request-cd-alert@deployment.service

[Service]
Type=oneshot
User=Ted_Kasane
Group=Ted_Kasane
SupplementaryGroups=docker
WorkingDirectory=/home/Ted_Kasane/tech-request-prod-deploy
ExecStart=/usr/bin/python3 -B /home/Ted_Kasane/tech-request-prod-deploy/pull-agent.py --dry-run
UMask=0077
TimeoutStartSec=35min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/Ted_Kasane/tech-request-prod-deploy /data/volumes/tech-request-prod/backups
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tech-request-cd
