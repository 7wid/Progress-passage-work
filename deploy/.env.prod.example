# 复制为 deploy/.env.prod 后修改；不要提交 deploy/.env.prod。
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# 浏览器实际访问的唯一公开源：协议 + 域名 + 可选端口，不要带路径。
APP_WEB_ORIGIN=https://example.edu.cn
HTTP_PORT=80
SESSION_COOKIE_SECURE=true

# 是否开放需求方自助注册；仅校内使用时可同时限制邮箱后缀，例如 @example.edu.cn。
APP_REGISTRATION_ENABLED=false
APP_REGISTRATION_EMAIL_SUFFIX=

# 连续登录失败保护；建议保持默认值，锁定期间仍统一返回“账号或密码错误”。
APP_LOGIN_SECURITY_MAX_FAILED_ATTEMPTS=5
APP_LOGIN_SECURITY_LOCK_DURATION=15m

# 邮箱找回密码：配置专用 SMTP 账号后开启。重置地址须为受信任的 HTTPS 页面。
APP_PASSWORD_RECOVERY_ENABLED=false
APP_PASSWORD_RECOVERY_FROM=
APP_PASSWORD_RECOVERY_RESET_URL=https://job.gxutech.xyz/reset-password
APP_PASSWORD_RECOVERY_TOKEN_TTL=15m
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
# 使用 465 隐式 TLS 时：SMTP_PORT=465、SMTP_STARTTLS_ENABLED=false、SMTP_SSL_ENABLED=true。

# 仅第一次启动时开启。管理员创建并验证登录后，改为 false 并删除密码值。
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_ACCOUNT=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-to-72-character-letter-and-number-password
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
